# Google Places API (New) - https://console.cloud.google.com/
# Habilitar Places API y Geocoding API en el proyecto
GOOGLE_MAPS_API_KEY=

# Outscraper - https://app.outscraper.com/profile  (para reviews completas)
OUTSCRAPER_API_KEY=

# Anthropic - https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Modelo a usar para analisis de reviews
ANTHROPIC_MODEL=claude-sonnet-4-6

# Cuantas reviews maximo bajamos por negocio (cap razonable para costos)
MAX_REVIEWS_PER_PLACE=80

# Path a la base local
DB_PATH=data/leads.db

# --- Generacion de landings ---
# Modelo para construir landings (Opus 4.7 da mejor diseno; Sonnet 4.6 es mas barato)
LANDING_MODEL=claude-opus-4-7

# Tu marca / nombre de agencia (aparece en el footer de cada landing)
LANDING_BRAND=BonnieAcion

# WhatsApp para CTA (formato internacional sin +, ej: 5491134000444 para AR mobile)
LANDING_WHATSAPP=5491134000444

# Para mostrar en pantalla (formato humano)
LANDING_WHATSAPP_DISPLAY=+54 9 11 3400-0444
